        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "template": {
          "enum": [
            "comparison",
            "personal_change",
            "measurement_limits"
          ],
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "template",
        "evidence_id"
      ],
      "title": "ClaimRecord",
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "trajectory",
            "comparison",
            "observation_status",
            "assessment_status"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "evidence_id"
      ],
      "title": "Panel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotation": {
      "enum": [
