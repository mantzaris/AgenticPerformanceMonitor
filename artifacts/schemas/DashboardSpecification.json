        "type": "string"
      },
      "maxItems": 3,
      "title": "Followups",
      "type": "array"
    },
    "panels": {
      "items": {
        "$ref": "#/$defs/Panel"
      },
      "maxItems": 6,
      "minItems": 2,
      "title": "Panels",
      "type": "array"
